POSTGRES_USER=careagent
POSTGRES_PASSWORD=careagent_dev
POSTGRES_DB=careagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

OPENAI_API_KEY=sk-...

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=careagent

MLFLOW_TRACKING_URI=http://localhost:5001

APP_ENV=development
LOG_LEVEL=INFO
CMS_DATA_PATH=data/cms_provider_2022.csv

# LLM model. gpt-4o-mini is removed from the OpenAI API on 2027-01-14; switch to its replacement and test.
OPENAI_MODEL=gpt-4o-mini
# Optional tuning (defaults shown). Models that reject a custom temperature are retried without it.
# OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_COMPLETION_TOKENS=400
# OPENAI_TIMEOUT_SECONDS=20
# OPENAI_MAX_RETRIES=1
