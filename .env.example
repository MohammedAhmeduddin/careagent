POSTGRES_USER=careagent
POSTGRES_PASSWORD=careagent_dev
POSTGRES_DB=careagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# require for Neon; disable for a local Postgres without TLS
POSTGRES_SSLMODE=require
# Or one connection string (overrides POSTGRES_*), e.g. from Secret Manager:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

OPENAI_API_KEY=sk-...

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=careagent

APP_ENV=development
LOG_LEVEL=INFO
CMS_DATA_PATH=data/raw/cms_providers_NJ_2024.csv

# LLM model. gpt-4o-mini is removed from the OpenAI API on 2027-01-14; gpt-6-luna is the recommended replacement.
OPENAI_MODEL=gpt-6-luna
# Optional tuning (defaults shown). Models that reject a custom temperature are retried without it.
# OPENAI_TEMPERATURE=0.1
# OPENAI_REASONING_EFFORT=none   # needed by gpt-6-luna for tool calls; "" to omit
# OPENAI_MAX_COMPLETION_TOKENS=4000
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=1
